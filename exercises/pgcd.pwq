%
% title
%
PGCD
%
% keywords
%
arithmétique, PGCD, nombres entiers
%
% layout
%
STD
%
% avant
%
from random import randint
from sympy import *
from pywims import py_wims, is_nombre

# Tire deux entiers et calcule leur plus grand diviseur commun.
x = randint(26,145)
y = randint(23,252)
resultat = gcd(x,y)

# Détaille l’algorithme d’Euclide pour expliquer la solution.
etapes = []
dividende, diviseur = max(x, y), min(x, y)
while diviseur:
    etapes.append(r"${} = {} \times {} + {}$".format(dividende, dividende // diviseur, diviseur, dividende % diviseur))
    dividende, diviseur = diviseur, dividende % diviseur
explication_solution = (
    "Algorithme d’Euclide : " + " ; ".join(etapes)
    + ". Le dernier reste non nul est ${}$.".format(resultat)
)
%
% enonce
%
Quel est le plus grand diviseur commun de ${{x}}$ et ${{y}}$ ?
<br>
Réponse : {% input_text 'reponse' solution=resultat style='width :5em' %}
%
% apres
%
# Convertit la saisie, puis explique l’erreur sans donner la réponse.
valeur = py_wims(reponse)
ok_answer['reponse'] = is_nombre(valeur) and valeur == resultat

if ok_answer['reponse']:
    feedback = 'Bravo, c’est exact !'
elif not is_nombre(valeur) or not valeur.is_Integer or valeur <= 0:
    feedback = 'Saisissez un nombre entier positif.'
elif x % valeur == 0 and y % valeur == 0:
    feedback = '{} divise bien {} et {}, mais ce n’est pas le plus grand diviseur commun.'.format(valeur, x, y)
else:
    feedback = '{} ne divise pas {}.'.format(valeur, x if x % valeur else y)
%
