%
% question_title
%
Addition de fractions
%
% question_keywords
%
fractions, addition, dénominateur commun, fraction irréductible
%
% question_layout
%
STD
%
% question_setup
%
from random import choice
from sympy import *
from pywims import py_wims

# Choisit deux fractions irréductibles, numérateurs et dénominateurs entre 2 et 5.
irreducible_fractions = [(a, b) for a in range(2, 6) for b in range(2, 6) if gcd(a, b) == 1]
n, m = choice(irreducible_fractions)
p, q = choice(irreducible_fractions)
total = Rational(n, m) + Rational(p, q)

# Réduction au même dénominateur, pour l’explication de la solution.
common = ilcm(m, q)
n_common = n * (common // m)
p_common = p * (common // q)
numerator_sum = n_common + p_common
# Dernière égalité, seulement si la fraction obtenue se simplifie.
simplified = "" if total.q == common else " = " + latex(total)
%
% question_statement
%
Additionnez ces fractions et donnez le résultat sous forme d’une fraction
irréductible, avec un dénominateur positif :
<br>
$\displaystyle \frac{ {{n}} }{ {{m}} } + \frac{ {{p}} }{ {{q}} } =$ {% input_text 'result' solution=total style='width:7em' %}
%
% question_solution_explanation
%
On réduit au même dénominateur ${{common}}$ :
$\displaystyle \frac{ {{n}} }{ {{m}} } + \frac{ {{p}} }{ {{q}} }
= \frac{ {{n_common}} }{ {{common}} } + \frac{ {{p_common}} }{ {{common}} }
= \frac{ {{numerator_sum}} }{ {{common}} }{{simplified}}$.
%
% question_check
%
# Interprète la réponse, puis vérifie la valeur avant la forme irréductible.
answer = py_wims(result)
ok_answer['result'] = False

if answer is None:
    feedback = "Saisissez une fraction d’entiers, par exemple 7/12."
else:
    numerator, denominator = fraction(answer)
    if not (numerator.is_Integer and denominator.is_Integer and denominator != 0):
        feedback = "Saisissez une fraction d’entiers, par exemple 7/12."
    elif simplify(answer - total) != 0:
        feedback = "Ce n’est pas la bonne somme : réduisez d’abord les deux fractions au même dénominateur."
    elif denominator < 0 or gcd(numerator, denominator) != 1:
        feedback = "La valeur est juste, mais la fraction n’est pas irréductible avec un dénominateur positif : simplifiez-la."
    else:
        ok_answer['result'] = True
        feedback = "Bravo, c’est exact !"
%
