% question_keywords
%
arithmétique, PGCD, nombres entiers
%
% question_layout
%
STD
%
% question_setup
%
from random import randint
from sympy import *

# Tire deux entiers et calcule leur plus grand diviseur commun.
x = randint(26,145)
y = randint(23,252)
result = gcd(x,y)

# Divisions de l’algorithme d’Euclide (dividende, quotient, diviseur, reste), pour l’explication.
steps = []
dividend, divisor = max(x, y), min(x, y)
while divisor:
    steps.append((dividend, dividend // divisor, divisor, dividend % divisor))
    dividend, divisor = divisor, dividend % divisor
%
% question_statement
%
Quel est le plus grand diviseur commun de ${{x}}$ et ${{y}}$ ?
<br>
Réponse : {{ input_value('answer', solution=result, style='width :5em') }}
%
% question_solution_explanation
%
Algorithme d’Euclide :
{% for a, quotient, b, remainder in steps -%}
${{a}} = {{quotient}} \times {{b}} + {{remainder}}${% if not loop.last %} ; {% endif %}
{%- endfor %}. Le dernier reste non nul est ${{result}}$.
%
% question_check
%
# La saisie arrive comme sa valeur (None si ce n’est pas un nombre), et ok_answer est déjà
# rempli par la correction par défaut : il ne reste qu’à expliquer l’erreur sans donner la réponse.
if ok_answer['answer']:
    feedback = 'Bravo, c’est exact !'
elif answer is None or not answer.is_Integer or answer <= 0:
    feedback = 'Saisissez un nombre entier positif.'
elif x % answer == 0 and y % answer == 0:
    feedback = '{} divise bien {} et {}, mais ce n’est pas le plus grand diviseur commun.'.format(answer, x, y)
else:
    feedback = '{} ne divise pas {}.'.format(answer, x if x % answer else y)
%
